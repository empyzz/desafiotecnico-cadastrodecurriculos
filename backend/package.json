{
  "name": "cadastro-candidatos-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests scripts *.js package.json",
    "format:check": "prettier --check src tests scripts *.js package.json"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "mssql": "^12.7.2",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
